---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import SourceCard from "../components/SourceCard.astro";
import { site } from "../config/site";
import { sources } from "../lib/content";
---

<BaseLayout title="Sources" description={`The approved ${site.name} source registry.`}>
  <PageHeader
    label="Evidence"
    title="Approved sources"
    description="Every story links to the exact report, dataset, or announcement used as evidence. This directory defines which publishers may be cited."
  />

  <section class="source-standard reveal delay-1" aria-labelledby="source-standard-title">
    <h2 id="source-standard-title">What approval means</h2>
    <p>The directory is limited to official agencies, intergovernmental bodies, and recognized evaluation authorities. Approval does not validate every claim; each report still checks and links to the exact publication.</p>
  </section>

  <section class="source-directory reveal delay-2" aria-labelledby="source-directory-title">
    <header>
      <h2 id="source-directory-title">Source directory</h2>
      <p>{sources.length} approved sources</p>
    </header>
    <div class="source-grid">
      {sources.map((source) => <SourceCard source={source} />)}
    </div>
  </section>
</BaseLayout>
