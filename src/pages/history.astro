---
import BaseLayout from "../layouts/BaseLayout.astro";
import HistoryChart from "../components/HistoryChart.astro";
import MetricBars from "../components/MetricBars.astro";
import PageHeader from "../components/PageHeader.astro";
import { formatDate } from "../lib/content";
import { history } from "../lib/history";

function formatMonth(value: string) {
  return new Intl.DateTimeFormat("en-US", {
    month: "short",
    year: "numeric",
    timeZone: "UTC"
  }).format(new Date(`${value}-01T00:00:00Z`));
}

function getSeries(chartId: string, label: string) {
  const chart = history.charts.find((candidate) => candidate.id === chartId);
  const series = chart?.series.find((candidate) => candidate.label === label);
  if (!chart || !series) throw new Error(`Dashboard series not found: ${chartId}/${label}`);
  const first = series.points[0];
  const latest = series.points.at(-1)!;
  return {
    chart,
    series,
    latest,
    change: ((latest.value - first.value) / first.value) * 100,
    latestPeriod: formatMonth(latest.date),
    firstPeriod: formatMonth(first.date),
    period: `${formatMonth(first.date)} to ${formatMonth(latest.date)}`
  };
}

const dashboardMetrics = [
  { label: "FAO dairy price index", ...getSeries("global-price-indices", "Dairy") },
  { label: "FAO meat price index", ...getSeries("global-price-indices", "Meat") },
  { label: "U.S. beef cows", ...getSeries("us-cattle-snapshots", "Beef cows") },
  { label: "U.S. calf crop", ...getSeries("us-cattle-snapshots", "Calf crop") }
];
const largestChange = Math.max(...dashboardMetrics.map((metric) => Math.abs(metric.change)));
---

<BaseLayout title="Data dashboard" description="Current readings and historical livestock and dairy market indicators.">
  <PageHeader
    label="Market dashboard"
    title="Livestock data dashboard"
    description="Current readings, recent direction, and historical context from recurring industry datasets."
  />

  <div class="history-update reveal delay-1">
    <span>Updated {formatDate(history.updatedAt)}</span>
    <p>Each measure keeps its source reporting period. Monthly and annual series are shown separately.</p>
  </div>

  <nav class="page-section-nav reveal delay-1" aria-label="Dashboard sections">
    <a href="#latest-readings">Latest readings</a>
    <a href="#period-change">Period change</a>
    <a href="#historical-bars">Historical bars</a>
  </nav>

  <section class="dashboard-summary reveal delay-2" id="latest-readings" aria-labelledby="dashboard-summary-title">
    <header>
      <div>
        <span>Latest readings</span>
        <h2 id="dashboard-summary-title">At a glance</h2>
      </div>
      <p>FAO values are monthly international price index points. USDA cattle values are national estimates in millions of head.</p>
    </header>
    <div class="dashboard-kpi-grid">
      {dashboardMetrics.map((metric) => (
        <article class="dashboard-kpi">
          <span>{metric.label}</span>
          <div class="dashboard-kpi-value">
            <strong>{metric.latest.value.toFixed(1)}</strong>
            <span>{metric.chart.unit}</span>
          </div>
          <div class="dashboard-kpi-period"><span>{metric.latestPeriod}</span><span>{metric.chart.cadence}</span></div>
          <MetricBars points={metric.series.points} label={metric.label} color={metric.series.color} />
          <p class:list={{ positive: metric.change > 0, negative: metric.change < 0 }}>
            {metric.change > 0 ? "+" : ""}{metric.change.toFixed(1)}% since {metric.firstPeriod}
          </p>
          <small class="dashboard-kpi-definition">{metric.series.definition}</small>
          <a href={metric.chart.sourceUrl} target="_blank" rel="noreferrer">{metric.chart.sourceTitle}</a>
        </article>
      ))}
    </div>
    <div class="dashboard-change-panel" id="period-change">
      <header>
        <div>
          <span>Period change</span>
          <h3>Direction and scale</h3>
        </div>
        <p>Percentage change over each stated period. The largest absolute change sets the visual scale.</p>
      </header>
      <ol>
        {dashboardMetrics.map((metric) => {
          const width = `${Math.max((Math.abs(metric.change) / largestChange) * 50, 1)}%`;
          return (
            <li>
              <span>{metric.label}</span>
              <div class="dashboard-change-track" aria-hidden="true">
                <i class:list={{ positive: metric.change > 0, negative: metric.change < 0 }} style={`--change-width:${width};--change-color:${metric.series.color}`}></i>
              </div>
              <strong>{metric.change > 0 ? "+" : ""}{metric.change.toFixed(1)}%</strong>
            </li>
          );
        })}
      </ol>
    </div>
  </section>

  <section class="history-chart-list reveal delay-3" id="historical-bars" aria-labelledby="historical-bars-title">
    <header class="history-list-heading">
      <div><span>Historical context</span><h2 id="historical-bars-title">Period-by-period history</h2></div>
      <p>Monthly series show one bar per month; annual series show one bar per reporting year. Exact values remain available in each data table.</p>
    </header>
    {history.charts.map((chart) => <HistoryChart chart={chart} />)}
  </section>
</BaseLayout>
