---
import BaseLayout from "../layouts/BaseLayout.astro";
import MarketExplorer from "../components/MarketExplorer.astro";
import MetricBars from "../components/MetricBars.astro";
import PageHeader from "../components/PageHeader.astro";
import { formatDate, reports } from "../lib/content";
import { history } from "../lib/history";

function getMetric(chartId: string, label: string, displayLabel: string) {
  const chart = history.charts.find((candidate) => candidate.id === chartId);
  const series = chart?.series.find((candidate) => candidate.label === label);
  if (!chart || !series) throw new Error(`Dashboard series not found: ${chartId}/${label}`);
  const latest = series.points.at(-1)!;
  const comparisonOffset = chart.cadence === "Monthly" && series.points.length > 12 ? 12
    : chart.cadence === "Quarterly" && series.points.length > 4 ? 4
    : 1;
  const comparison = series.points.at(-(comparisonOffset + 1)) ?? series.points[0];
  const change = comparison.value === 0 ? 0 : ((latest.value - comparison.value) / comparison.value) * 100;
  const basis = comparisonOffset === 1 ? "from prior period" : "from one year earlier";
  const visiblePoints = series.points.slice(-12);
  return { chart, series, latest, comparison, change, basis, visiblePoints, displayLabel };
}

function formatMetric(metric: ReturnType<typeof getMetric>) {
  if (metric.chart.format === "currency-2") return `$${metric.latest.value.toFixed(2)}`;
  if (metric.chart.format === "integer") return Math.round(metric.latest.value).toLocaleString("en-US");
  return metric.latest.value.toFixed(1);
}

const dashboardMetrics = [
  getMetric("global-price-indices", "Dairy", "Global dairy prices"),
  getMetric("global-price-indices", "Meat", "Global meat prices"),
  getMetric("us-all-milk-price", "All-milk price", "U.S. all-milk price"),
  getMetric("us-milk-production", "Milk production", "U.S. milk production"),
  getMetric("us-beef-retail-values", "All-fresh beef", "U.S. retail beef"),
  getMetric("us-cattle-snapshots", "Beef cows", "U.S. beef cows")
];

const globalDairy = dashboardMetrics[0];
const milkProduction = dashboardMetrics[3];
const retailBeef = dashboardMetrics[4];
const marketNarrative = `Global dairy prices are ${Math.abs(globalDairy.change).toFixed(1)}% ${globalDairy.change < 0 ? "below" : "above"} last year. U.S. milk production is ${Math.abs(milkProduction.change).toFixed(1)}% ${milkProduction.change < 0 ? "lower" : "higher"}, while retail beef values are ${Math.abs(retailBeef.change).toFixed(1)}% ${retailBeef.change < 0 ? "lower" : "higher"}.`;

const latestReport = reports[0];
const geneticsItems = latestReport?.items.filter((item) => item.sectors.includes("bovine-genetics")).slice(0, 2) ?? [];
const weeklyContext = latestReport?.overview?.points ?? [];
---

<BaseLayout title="Market dashboard" description="Interactive global and U.S. livestock, dairy, and bovine genetics indicators for Proterra business owners.">
  <PageHeader
    label="Market dashboard"
    title="Market conditions at a glance"
    description="Track the recurring indicators behind the weekly brief, then use the news to understand what changed."
  />

  <div class="history-update reveal delay-1">
    <span>Dashboard refreshed {formatDate(history.updatedAt)}</span>
    <p>Official recurring datasets only. Article claims are kept in the weekly brief, not blended into these series.</p>
  </div>

  <nav class="page-section-nav reveal delay-1" aria-label="Dashboard sections">
    <a href="#snapshot">Market snapshot</a>
    <a href="#market-explorer">Market explorer</a>
    <a href="#weekly-context">Weekly context</a>
    <a href="#genetics-watch">Genetics watch</a>
  </nav>

  <section class="dashboard-narrative reveal delay-2" aria-labelledby="dashboard-narrative-title">
    <span>This period</span>
    <h2 id="dashboard-narrative-title">{marketNarrative}</h2>
    <p>Each comparison uses the prior year when the source history supports it. Reporting dates differ by dataset.</p>
  </section>

  <section class="dashboard-summary reveal delay-2" id="snapshot" aria-labelledby="dashboard-summary-title">
    <header>
      <div><span>Select a market</span><h2 id="dashboard-summary-title">Market snapshot</h2></div>
      <p>Choose a reading to update the market explorer.</p>
    </header>
    <div class="dashboard-kpi-grid">
      {dashboardMetrics.map((metric, index) => (
        <button
          type="button"
          class="dashboard-kpi"
          data-market-selector
          data-chart-id={metric.chart.id}
          data-series={metric.series.label}
          aria-controls="market-explorer"
          aria-pressed={index === 0 ? "true" : "false"}
        >
          <div class="dashboard-kpi-topline"><span>{metric.displayLabel}</span><i style={`--metric-color:${metric.series.color}`}></i></div>
          <div class="dashboard-kpi-value"><strong>{formatMetric(metric)}</strong><span>{metric.chart.unit}</span></div>
          <div class="dashboard-kpi-period"><span>{metric.latest.label}</span><span>{metric.chart.cadence}</span></div>
          <MetricBars
            points={metric.visiblePoints}
            label={metric.displayLabel}
            color={metric.series.color}
            format={metric.chart.format}
            unit={metric.chart.unit}
          />
          <p class:list={{ positive: metric.change > 0, negative: metric.change < 0 }}>
            {metric.change > 0 ? "+" : ""}{metric.change.toFixed(1)}% {metric.basis}
          </p>
          <span class="dashboard-kpi-action">View in explorer</span>
        </button>
      ))}
    </div>
  </section>

  <section class="history-chart-list reveal delay-3" aria-labelledby="historical-bars-title">
    <header class="history-list-heading">
      <div><span>Interactive history</span><h2 id="historical-bars-title">Market explorer</h2></div>
      <p>Change the market above, select a range, then inspect individual values.</p>
    </header>
    <MarketExplorer charts={history.charts} />
  </section>

  <section class="dashboard-weekly-context" id="weekly-context" aria-labelledby="weekly-context-title">
    <header>
      <div><span>Latest brief</span><h2 id="weekly-context-title">What to watch</h2></div>
      <a href={`/reports/${latestReport.slug}`}>Read the full weekly brief</a>
    </header>
    <div>
      {weeklyContext.map((point, index) => (
        <article><span>{String(index + 1).padStart(2, "0")}</span><div><h3>{point.label}</h3><p>{point.text}</p></div></article>
      ))}
    </div>
  </section>

  <section class="genetics-watch" id="genetics-watch" aria-labelledby="genetics-watch-title">
    <header>
      <div><span>Event-driven tracker</span><h2 id="genetics-watch-title">Bovine genetics watch</h2></div>
      <p>Genetic evaluations change on release schedules, not in a clean monthly market series. The latest reviewed releases stay visible here.</p>
    </header>
    <div>
      {geneticsItems.map((item) => (
        <article>
          <div><span>{item.documentType.replace("-", " ")}</span><span>{formatDate(item.citations[0].publishedAt, { month: "short", day: "numeric", year: "numeric" })}</span></div>
          <h3><a href={item.citations[0].url} target="_blank" rel="noreferrer">{item.headline}</a></h3>
          <p>{item.summary}</p>
          <footer><span>{item.citations[0].sourceNote}</span><a href={`/reports/${latestReport.slug}#item-${item.rank}`}>Read in weekly brief</a></footer>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
