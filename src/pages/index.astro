---
import ArrowLink from "../components/ArrowLink.astro";
import FeaturedStory from "../components/FeaturedStory.astro";
import IssueSummary from "../components/IssueSummary.astro";
import SectionLabel from "../components/SectionLabel.astro";
import WeekDashboard from "../components/WeekDashboard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatDate, reports } from "../lib/content";

const latest = reports[0];
---

<BaseLayout>
  <section class="hero reveal">
    <SectionLabel>Weekly Brief</SectionLabel>
    <h1>This week in livestock and genetics.</h1>
    <p class="hero-summary">
      A concise weekly view of dairy, meat, and bovine genetics, with every development linked to its evidence.
    </p>
  </section>

  {latest ? (
    <>
      <section class="latest-heading reveal delay-1">
        <div>
          <SectionLabel>Issue {String(latest.issueNumber).padStart(2, "0")}</SectionLabel>
          <h2>{formatDate(latest.publishedAt)}</h2>
        </div>
        <ArrowLink href={`/reports/${latest.slug}`} label="Read Weekly Brief" />
      </section>

      <IssueSummary overview={latest.overview} fallback={latest.executiveSummary} />

      {latest.dashboard && (
        <div class="reveal delay-2">
          <WeekDashboard dashboard={latest.dashboard} reportHref={`/reports/${latest.slug}`} />
        </div>
      )}

      <section class="leading-stories reveal delay-3" aria-labelledby="leading-stories-title">
        <header class="content-section-heading">
          <div>
            <span>Ranked developments</span>
            <h2 id="leading-stories-title">Start here</h2>
          </div>
          <ArrowLink href={`/reports/${latest.slug}`} label={`View all ${latest.items.length} stories`} />
        </header>
        <div class="featured-grid">
          {latest.items.slice(0, 3).map((item, index) => (
            <FeaturedStory
              item={item}
              href={`/reports/${latest.slug}#item-${item.rank}`}
              primary={index === 0}
            />
          ))}
        </div>
      </section>
    </>
  ) : (
    <section class="empty-issue reveal delay-2">
      <div>
        <span class="status-dot" aria-hidden="true"></span>
        <p>Awaiting first review</p>
      </div>
      <h2>No Weekly Brief published yet.</h2>
      <p>The first reviewed issue will appear here.</p>
      <div class="empty-actions">
        <ArrowLink href="/methodology" label="Review methodology" />
        <ArrowLink href="/sources" label="Inspect source registry" />
      </div>
    </section>
  )}

  <section class="principles reveal" aria-labelledby="how-it-works-title">
    <div class="section-intro">
      <h2 id="how-it-works-title">Built for a quick, trusted read</h2>
    </div>
    <div class="principle-list">
      <article>
        <span>01</span>
        <div><h3>Approved sources</h3><p>Research begins with a reviewed registry of authoritative publishers.</p></div>
      </article>
      <article>
        <span>02</span>
        <div><h3>Consistent ranking</h3><p>Impact, evidence, timeliness, relevance, breadth, and novelty determine selection.</p></div>
      </article>
      <article>
        <span>03</span>
        <div><h3>Human review</h3><p>Every claim links to evidence, and every issue requires approval.</p></div>
      </article>
    </div>
  </section>
</BaseLayout>
