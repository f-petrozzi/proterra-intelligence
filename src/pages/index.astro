---
import ArrowLink from "../components/ArrowLink.astro";
import NewsReel from "../components/NewsReel.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { reports } from "../lib/content";

const latest = reports[0];
---

<BaseLayout>
  {latest ? (
    <div class="reveal"><NewsReel report={latest} /></div>
  ) : (
    <section class="empty-issue reveal delay-2">
      <div>
        <span class="status-dot" aria-hidden="true"></span>
        <p>Awaiting first review</p>
      </div>
      <h1>No Weekly Brief published yet.</h1>
      <p>The first reviewed issue will appear here.</p>
      <div class="empty-actions">
        <ArrowLink href="/methodology" label="Review methodology" />
        <ArrowLink href="/sources" label="Inspect source registry" />
      </div>
    </section>
  )}

</BaseLayout>
