---
import ArrowLink from "../components/ArrowLink.astro";
import ReportCard from "../components/ReportCard.astro";
import SectionLabel from "../components/SectionLabel.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatDate, reports, sources } from "../lib/content";

const latest = reports[0];
const approvedSourceCount = sources.filter((source) => source.status === "approved").length;
---

<BaseLayout>
  <section class="hero reveal">
    <SectionLabel>Weekly Brief</SectionLabel>
    <h1>This week in livestock and genetics.</h1>
    <p class="hero-summary">
      A weekly review of important developments in dairy, meat, and bovine genetics, with direct sources and human review.
    </p>
    <div class="hero-meta" aria-label="Publication standards">
      <div><strong>8 to 10</strong><span>developments</span></div>
      <div><strong>{approvedSourceCount}</strong><span>approved sources</span></div>
      <div><strong>Weekly</strong><span>human review</span></div>
    </div>
  </section>

  {latest ? (
    <>
      <section class="latest-heading reveal delay-1">
        <div>
          <SectionLabel>Issue {String(latest.issueNumber).padStart(2, "0")}</SectionLabel>
          <h2>{formatDate(latest.publishedAt)}</h2>
        </div>
        <ArrowLink href={`/reports/${latest.slug}`} label="Read Weekly Brief" />
      </section>

      <section class="executive-summary reveal delay-2">
        <span>Executive summary</span>
        <p>{latest.executiveSummary}</p>
      </section>

      <section class="signal-grid reveal delay-3" aria-label="Leading signals">
        {latest.items.slice(0, 3).map((item) => <ReportCard item={item} compact />)}
      </section>
    </>
  ) : (
    <section class="empty-issue reveal delay-2">
      <div>
        <span class="status-dot" aria-hidden="true"></span>
        <p>Awaiting first review</p>
      </div>
      <h2>No Weekly Brief published yet.</h2>
      <p>The first reviewed issue will appear here.</p>
      <div class="empty-actions">
        <ArrowLink href="/methodology" label="Review methodology" />
        <ArrowLink href="/sources" label="Inspect source registry" />
      </div>
    </section>
  )}

  <section class="principles reveal">
    <div class="section-intro">
      <SectionLabel>Editorial standard</SectionLabel>
      <h2>Evidence first.<br />Interpretation second.</h2>
    </div>
    <div class="principle-list">
      <article>
        <span>01</span>
        <div><h3>Approved sources</h3><p>Research begins with a reviewed registry of authoritative publishers.</p></div>
      </article>
      <article>
        <span>02</span>
        <div><h3>Consistent ranking</h3><p>Impact, evidence, timeliness, relevance, breadth, and novelty determine selection.</p></div>
      </article>
      <article>
        <span>03</span>
        <div><h3>Human review</h3><p>Every claim links to evidence, and every issue requires approval.</p></div>
      </article>
    </div>
  </section>
</BaseLayout>
