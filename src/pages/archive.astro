---
import ArrowLink from "../components/ArrowLink.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { site } from "../config/site";
import { formatDate, reports, sectorLabel, sectors } from "../lib/content";

const latestReport = reports[0];
const coveredSectors = new Set(reports.flatMap((report) => report.items.flatMap((item) => item.sectors))).size;
---

<BaseLayout title="Archive" description={`Approved ${site.name} Weekly Briefs.`}>
  <PageHeader
    label="Past issues"
    title="Briefing archive"
    description="Browse every reviewed weekly issue with its original publication date, coverage, and sources."
  />

  <section class="archive-shell reveal delay-1">
    <div class="archive-summary" aria-label="Archive summary">
      <article><strong>{reports.length}</strong><span>Published issue{reports.length === 1 ? "" : "s"}</span></article>
      <article><strong>{latestReport ? formatDate(latestReport.publishedAt, { month: "short", day: "numeric" }) : "None"}</strong><span>Latest publication</span></article>
      <article><strong>{coveredSectors}</strong><span>Sectors covered</span></article>
    </div>

    <header class="archive-toolbar">
      <div><span>Issue library</span><h2>All briefings</h2></div>
      <p>Filter by the sectors included in each issue.</p>
    </header>
    <div class="filter-bar" role="group" aria-label="Filter reports">
      <button type="button" class="active" data-filter="all" aria-pressed="true">All</button>
      {sectors.map((sector) => (
        <button type="button" data-filter={sector} aria-pressed="false">{sectorLabel(sector)}</button>
      ))}
    </div>

    <div class="archive-list" id="archive-list">
      {reports.length > 0 ? reports.map((report) => {
        const reportSectors = [...new Set(report.items.flatMap((item) => item.sectors))];
        return (
          <article class="archive-row" data-sectors={reportSectors.join(" ")}>
            <div class="issue-index"><span>Issue</span><strong>{String(report.issueNumber).padStart(2, "0")}</strong></div>
            <div class="archive-copy">
              <div class="tag-list">
                {reportSectors.map((sector) => <span>{sectorLabel(sector)}</span>)}
                {report.status === "draft" && <span class="draft-tag">Draft preview</span>}
              </div>
              <h3><a href={`/reports/${report.slug}`}>{formatDate(report.publishedAt)}</a></h3>
              <p>{report.executiveSummary}</p>
            </div>
            <ArrowLink href={`/reports/${report.slug}`} label={`Open Issue ${String(report.issueNumber).padStart(2, "0")}`} />
          </article>
        );
      }) : (
        <div class="archive-empty">
          <p>No approved reports yet.</p>
          <span>The archive will populate after the first reviewed issue is merged.</span>
        </div>
      )}
    </div>
  </section>

  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
    const rows = document.querySelectorAll<HTMLElement>(".archive-row");

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const filter = button.dataset.filter ?? "all";
        buttons.forEach((candidate) => {
          const selected = candidate === button;
          candidate.classList.toggle("active", selected);
          candidate.setAttribute("aria-pressed", String(selected));
        });
        rows.forEach((row) => {
          row.hidden = filter !== "all" && !(row.dataset.sectors ?? "").split(" ").includes(filter);
        });
      });
    });
  </script>
</BaseLayout>
