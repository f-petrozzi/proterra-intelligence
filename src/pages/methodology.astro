---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import SectionLabel from "../components/SectionLabel.astro";
import { site } from "../config/site";
---

<BaseLayout title="Methodology" description={`How ${site.name} discovers, ranks, and reviews industry developments.`}>
  <PageHeader
    label="Editorial methodology"
    title="How each development is selected"
    description="A consistent process for researching, ranking, and approving each Weekly Brief."
  />

  <section class="method-grid reveal delay-1">
    <article><span>01</span><h2>Discover</h2><p>Search the previous seven days across approved sources, with up to 30 days of context for continuing developments.</p></article>
    <article><span>02</span><h2>Verify</h2><p>Trace claims to exact publications. Promotional, broad, or disputed claims require independent context.</p></article>
    <article><span>03</span><h2>Rank</h2><p>Score candidates for business impact, evidence strength, timeliness, relevance to Proterra, breadth, and novelty.</p></article>
    <article><span>04</span><h2>Review</h2><p>Validate links, claims, balance, and interpretation in a protected preview before publication.</p></article>
  </section>

  <section class="rubric reveal delay-2">
    <div class="section-intro">
      <SectionLabel>Ranking rubric</SectionLabel>
      <h2>How stories are ranked</h2>
    </div>
    <div class="rubric-table">
      <div><span>Business impact</span><strong>30%</strong></div>
      <div><span>Evidence strength</span><strong>25%</strong></div>
      <div><span>Timeliness</span><strong>15%</strong></div>
      <div><span>Relevance to Proterra</span><strong>15%</strong></div>
      <div><span>Breadth</span><strong>10%</strong></div>
      <div><span>Novelty</span><strong>5%</strong></div>
    </div>
  </section>

  <section class="guardrails reveal">
    <div>
      <SectionLabel>Publication guardrails</SectionLabel>
      <h2>What an approved issue must contain</h2>
    </div>
    <ul>
      <li><span>8 to 10</span> supported developments</li>
      <li><span>2+</span> items from each sector</li>
      <li><span>3+</span> primarily U.S. items</li>
      <li><span>3+</span> primarily international items</li>
      <li><span>100%</span> exact source attribution</li>
      <li><span>Required</span> human approval before publishing</li>
    </ul>
  </section>
</BaseLayout>
