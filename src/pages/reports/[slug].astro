---
import IssueSummary from "../../components/IssueSummary.astro";
import ReportCard from "../../components/ReportCard.astro";
import WeekDashboard from "../../components/WeekDashboard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate, reports, sourceById, type Report } from "../../lib/content";

export function getStaticPaths() {
  return reports.map((report) => ({ params: { slug: report.slug }, props: { report } }));
}

interface Props {
  report: Report;
}

const { report } = Astro.props as Props;
---

<BaseLayout title={`Issue ${report.issueNumber}`} description={report.executiveSummary}>
  <article class="report-page">
    <header class="report-header reveal">
      <div class="report-kicker">
        <span>Weekly Brief</span>
        <span>Issue {String(report.issueNumber).padStart(2, "0")}{report.status === "draft" ? " · Draft preview" : ""}</span>
      </div>
      <h1>{formatDate(report.publishedAt)}</h1>
      <div class="report-period">
        Reporting period: {formatDate(report.period.start, { month: "short" })} to {formatDate(report.period.end, { month: "short" })}
      </div>
    </header>

    <IssueSummary
      overview={report.overview}
      fallback={report.executiveSummary}
      editorNote={report.editorNote}
    />

    {report.dashboard && (
      <div class="report-dashboard reveal delay-1">
        <WeekDashboard dashboard={report.dashboard} reportHref={`/reports/${report.slug}`} />
      </div>
    )}

    <section class="report-items reveal delay-2" aria-labelledby="report-items-title">
      <header class="report-items-heading">
        <h2 id="report-items-title">All stories</h2>
        <p>Ranked by business impact, evidence, and relevance to Proterra.</p>
      </header>
      {report.items.map((item) => (
        <div class="report-item" id={`item-${item.rank}`}>
          <ReportCard item={item} />
          <div class="evidence-panel">
            <div>
              <span class="evidence-label">Watch next</span>
              <p>{item.watchNext}</p>
            </div>
            <div>
              <div class="evidence-heading">
                <span class="evidence-label">Sources</span>
                <span class="confidence-label">{item.confidence} confidence</span>
              </div>
              <ul class="citation-list">
                {item.citations.map((citation) => {
                  const isPdf = new URL(citation.url).pathname.toLowerCase().endsWith(".pdf");
                  return (
                    <li>
                      <a class="citation-link" href={citation.url} target="_blank" rel="noreferrer">
                        <span class="citation-meta">
                          <span>{sourceById.get(citation.sourceId)?.name}</span>
                          <time datetime={citation.publishedAt}>{formatDate(citation.publishedAt, { month: "short" })}</time>
                        </span>
                        <strong>{citation.title}</strong>
                        <span class="citation-action">
                          {isPdf ? "Open PDF" : "Open source"}
                          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9M8.5 3.5 13 8l-4.5 4.5"></path></svg>
                        </span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          </div>
        </div>
      ))}
    </section>
  </article>
</BaseLayout>
