---
import NewsReel from "../../components/NewsReel.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate, reports, type Report } from "../../lib/content";

export function getStaticPaths() {
  return reports.map((report) => ({ params: { slug: report.slug }, props: { report } }));
}

interface Props {
  report: Report;
}

const { report } = Astro.props as Props;
---

<BaseLayout title={`Issue ${report.issueNumber}`} description={report.executiveSummary}>
  <article class="report-page">
    <header class="issue-page-heading reveal">
      <span>Weekly Brief · Issue {String(report.issueNumber).padStart(2, "0")}</span>
      <h1>Week of {formatDate(report.publishedAt)}</h1>
      <p>{formatDate(report.period.start, { month: "short" })} to {formatDate(report.period.end, { month: "short" })}</p>
    </header>
    <NewsReel report={report} />
  </article>
</BaseLayout>
