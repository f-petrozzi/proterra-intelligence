---
import { sectorLabel, type Report } from "../lib/content";
import IssueCharts from "./IssueCharts.astro";

interface Props {
  dashboard: NonNullable<Report["dashboard"]>;
  items: Report["items"];
  reportHref: string;
}

const { dashboard, items, reportHref } = Astro.props;
const directionLabels = {
  up: "Up",
  down: "Down",
  new: "New",
  stable: "Stable"
} as const;
const directionMarks = {
  up: "↗",
  down: "↘",
  new: "+",
  stable: "→"
} as const;
---

<section class="week-dashboard" aria-labelledby="market-pulse-title">
  <header class="dashboard-heading">
    <div>
      <span>At a glance</span>
      <h2 id="market-pulse-title">This week’s indicators</h2>
    </div>
    <p>Comparable figures cited in this issue. Select any indicator to read the underlying story.</p>
  </header>

  <div class="pulse-grid">
    {dashboard.sectorPulses.map((pulse) => (
      <a
        class="pulse-card"
        data-sector={pulse.sector}
        href={`${reportHref}#item-${pulse.itemRank}`}
        aria-label={`${sectorLabel(pulse.sector)}: ${pulse.label}, ${pulse.value}. Read item ${pulse.itemRank}.`}
      >
        <div class="pulse-topline">
          <span>{sectorLabel(pulse.sector)}</span>
          <span class="direction">
            <span aria-hidden="true">{directionMarks[pulse.direction]}</span>
            {directionLabels[pulse.direction]}
          </span>
        </div>
        <strong>{pulse.value}</strong>
        <div class="pulse-label">
          <h3>{pulse.label}</h3>
          <span>{pulse.basis}</span>
        </div>
        <p>{pulse.note}</p>
        <span class="item-reference">Read story {String(pulse.itemRank).padStart(2, "0")}</span>
      </a>
    ))}
  </div>

  <div class="metrics-panel">
    <div class="metrics-heading">
      <div>
        <span>Also in this issue</span>
        <h3>Key numbers</h3>
      </div>
    </div>
    <div class="metric-grid">
      {dashboard.keyMetrics.map((metric) => (
        <a href={`${reportHref}#item-${metric.itemRank}`} class="metric-card">
          <strong>{metric.value}</strong>
          <span>{metric.label}</span>
          <small>{metric.basis}</small>
        </a>
      ))}
    </div>
  </div>

  {dashboard.charts && (
    <IssueCharts charts={dashboard.charts} items={items} reportHref={reportHref} />
  )}
</section>
