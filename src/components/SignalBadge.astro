---
import type { SignalItem } from "../lib/content";

interface Props {
  signal: SignalItem["signal"];
}

const { signal } = Astro.props;
const labels = {
  new: "New this week",
  continuing: "Continuing",
  accelerating: "Accelerating",
  easing: "Easing"
} as const;
---

<span class={`signal-badge signal-${signal}`}>{labels[signal]}</span>
