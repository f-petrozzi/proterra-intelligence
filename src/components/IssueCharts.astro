---
import { sourceById, type Report } from "../lib/content";

interface Props {
  charts: NonNullable<NonNullable<Report["dashboard"]>["charts"]>;
  items: Report["items"];
  reportHref: string;
}

const { charts, items, reportHref } = Astro.props;
---

<section class="issue-charts" aria-labelledby="visual-brief-title">
  <header class="visual-brief-heading">
    <div>
      <span>Data appendix</span>
      <h2 id="visual-brief-title">Numbers behind the reading list</h2>
    </div>
    <p>Selected figures from this issue. Each chart states its period and links to the supporting publication.</p>
  </header>

  <div class="chart-grid">
    {charts.map((chart, chartIndex) => {
      const maxMagnitude = Math.max(...chart.values.map((entry) => Math.abs(entry.value)), 1);
      const citations = chart.sourceIds.flatMap((sourceId) => {
        const citation = items
          .filter((item) => chart.itemRanks.includes(item.rank))
          .flatMap((item) => item.citations)
          .find((candidate) => candidate.sourceId === sourceId);
        return citation ? [{ ...citation, sourceName: sourceById.get(sourceId)?.name }] : [];
      });

      return (
        <article class="comparison-chart" data-chart-index={chartIndex}>
          <header>
            <h3>{chart.title}</h3>
            <p>{chart.description}</p>
          </header>

          <div class="chart-direction" aria-hidden="true">
            <span>Decrease</span>
            <span>Increase</span>
          </div>

          <ul class="bar-chart" aria-label={`${chart.title}. ${chart.description}`}>
            {chart.values.map((entry) => {
              const barWidth = Math.abs(entry.value) === 0
                ? "0%"
                : `${Math.max((Math.abs(entry.value) / maxMagnitude) * 50, 1.5)}%`;
              return (
                <li>
                  <span class="bar-label">{entry.label}</span>
                  <span class="bar-track" aria-hidden="true">
                    <span
                      class:list={["bar-fill", { positive: entry.value >= 0, negative: entry.value < 0 }]}
                      style={`--bar-width: ${barWidth}`}
                    ></span>
                  </span>
                  <strong>{entry.displayValue}</strong>
                </li>
              );
            })}
          </ul>

          <footer>
            <span>
              {citations.map((citation, index) => (
                <>
                  {index > 0 && ", "}
                  <a href={citation.url} target="_blank" rel="noreferrer">{citation.sourceName}</a>
                </>
              ))}
            </span>
            <span>
              {chart.itemRanks.map((rank, index) => (
                <>
                  {index > 0 && ", "}
                  <a href={`${reportHref}#item-${rank}`}>Source {String(rank).padStart(2, "0")}</a>
                </>
              ))}
            </span>
          </footer>
        </article>
      );
    })}
  </div>
</section>
