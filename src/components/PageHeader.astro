---
import SectionLabel from "./SectionLabel.astro";

interface Props {
  label?: string;
  title: string;
  description?: string;
}

const { label, title, description } = Astro.props;
---

<header class="page-heading reveal">
  {label && <SectionLabel>{label}</SectionLabel>}
  <h1>{title}</h1>
  {description && <p>{description}</p>}
</header>
