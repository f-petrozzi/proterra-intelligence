---
import ArrowLink from "./ArrowLink.astro";
import { formatDate, isLatinAmericaRegion, sectorLabel, sourceById, type Report, type SignalItem } from "../lib/content";
import { imageById, type EditorialImage } from "../lib/images";

interface Props {
  report: Report;
}

const { report } = Astro.props;
const groups = Array.from(
  report.items.reduce((map, item) => {
    const key = item.citations[0].url;
    map.set(key, [...(map.get(key) ?? []), item]);
    return map;
  }, new Map<string, SignalItem[]>()).values()
);
const leadGroup = groups[0];
const regionalGroups = groups.slice(1).filter((group) => group.some((item) => isLatinAmericaRegion(item.regions)));
const regionalUrls = new Set(regionalGroups.map((group) => group[0].citations[0].url));
const feedGroups = groups.slice(1).filter((group) => !regionalUrls.has(group[0].citations[0].url));

function imageFor(items: SignalItem[]): EditorialImage {
  const image = imageById.get(items[0].imageId);
  if (!image) throw new Error(`Missing editorial image "${items[0].imageId}".`);
  return image;
}

function tagsFor(items: SignalItem[]) {
  return [
    ...new Set([
      ...items.flatMap((item) => item.sectors.map(sectorLabel)),
      ...items.flatMap((item) => item.regions)
    ])
  ];
}

function publisherFor(items: SignalItem[]) {
  const citation = items[0].citations[0];
  if (citation.sourceId === "linkedin-org-post") return `${citation.title} · LinkedIn`;
  return sourceById.get(citation.sourceId)?.name ?? citation.sourceId;
}

function citationLabel(sourceId: string, title: string) {
  if (sourceId === "linkedin-org-post") return title;
  return sourceById.get(sourceId)?.name ?? title;
}

function supportingFor(items: SignalItem[]) {
  const primaryUrl = items[0].citations[0].url;
  return items.flatMap((item) => item.citations)
    .filter((citation) => citation.url !== primaryUrl)
    .filter((citation, index, citations) => citations.findIndex((candidate) => candidate.url === citation.url) === index);
}

const leadImage = imageFor(leadGroup);
const leadCitation = leadGroup[0].citations[0];
const leadSupporting = supportingFor(leadGroup);
const reportHref = `/reports/${report.slug}`;
---

<section class="news-reel" aria-labelledby="news-reel-title">
  {report.status === "draft" && (
    <aside class="draft-review-notice" aria-labelledby="draft-review-title">
      <div>
        <span>Draft preview</span>
        <h2 id="draft-review-title">Review Issue {String(report.issueNumber).padStart(2, "0")}</h2>
      </div>
      <p>
        This issue is not published. Check the source links, facts, and wording in this preview,
        then approve it from the pull request when it is ready.
      </p>
    </aside>
  )}

  <header class="news-reel-header">
    <div>
      <span>Issue {String(report.issueNumber).padStart(2, "0")} · {formatDate(report.publishedAt)}</span>
      <h2 id="news-reel-title">This week</h2>
    </div>
    <nav aria-label="Issue sections">
      <a href={`#item-${leadGroup[0].rank}`}>Top story</a>
      <a href="#latest-news">Latest</a>
      <a href="#latin-america">Latin America &amp; PR</a>
      <a href="/history">Dashboard</a>
    </nav>
  </header>

  <article class="lead-news" id={`item-${leadGroup[0].rank}`}>
    <figure>
      <img src={leadImage.src} alt={leadImage.alt} width="1280" height="720" loading="eager" fetchpriority="high" />
      <figcaption>
        <a href={leadImage.sourceUrl} target="_blank" rel="noreferrer">
          {leadImage.creator} · {leadImage.license}
        </a>
      </figcaption>
    </figure>
    <div class="lead-news-copy">
      <div class="news-meta">
        <span>{publisherFor(leadGroup)}</span>
        <time datetime={leadCitation.publishedAt}>{formatDate(leadCitation.publishedAt)}</time>
      </div>
      <h3><a href={leadCitation.url} target="_blank" rel="noreferrer">{leadGroup[0].headline}</a></h3>
      <p>{leadGroup[0].summary}</p>
      <ul>
        {leadGroup[0].keyPoints.slice(0, 3).map((point) => <li>{point}</li>)}
      </ul>
      <details class="lead-relevance">
        <summary>Why it matters to Proterra</summary>
        <p>{leadGroup[0].businessRelevance}</p>
      </details>
      <div class="lead-news-footer">
        <a href={leadCitation.url} target="_blank" rel="noreferrer">
          <span>Read the source</span>
          <strong>{leadCitation.title}</strong>
        </a>
        {leadSupporting.length > 0 && (
          <div class="lead-supporting-links" aria-label="Supporting sources">
            <span>Also:</span>
            {leadSupporting.map((citation) => (
              <a href={citation.url} target="_blank" rel="noreferrer">
                {citationLabel(citation.sourceId, citation.title)}
              </a>
            ))}
          </div>
        )}
        <div class="lead-news-tags">{tagsFor(leadGroup).map((tag) => <span>{tag}</span>)}</div>
      </div>
    </div>
  </article>

  <div class="news-columns">
    <section class="latest-news" id="latest-news" aria-labelledby="latest-news-title">
      <header class="news-section-heading">
        <h3 id="latest-news-title">Latest briefing</h3>
        <span>{feedGroups.length} sources</span>
      </header>

      <div class="news-feed">
        {feedGroups.map((items) => {
          const citation = items[0].citations[0];
          const image = imageFor(items);
          const supporting = supportingFor(items);
          return (
            <article class="news-row" id={`item-${items[0].rank}`}>
              {items.slice(1).map((item) => <span class="source-anchor" id={`item-${item.rank}`} aria-hidden="true"></span>)}
              <figure class="news-row-image">
                <a href={citation.url} target="_blank" rel="noreferrer" aria-label={`Open source: ${citation.title}`}>
                  <img src={image.src} alt={image.alt} width="1280" height="720" loading="lazy" />
                </a>
                <figcaption>
                  <a href={image.sourceUrl} target="_blank" rel="noreferrer">Photo: {image.creator}</a>
                </figcaption>
              </figure>
              <div class="news-row-copy">
                <div class="news-meta">
                  <span>{publisherFor(items)}</span>
                  <time datetime={citation.publishedAt}>{formatDate(citation.publishedAt, { month: "short" })}</time>
                </div>
                {items.map((item, index) => (
                  <section class:list={{ "related-topic": index > 0 }}>
                    {index === 0
                      ? <h3><a href={item.citations[0].url} target="_blank" rel="noreferrer">{item.headline}</a></h3>
                      : <h4><a href={item.citations[0].url} target="_blank" rel="noreferrer">{item.headline}</a></h4>}
                    <p>{item.summary}</p>
                  </section>
                ))}
                <div class="news-row-actions">
                  <details>
                    <summary>Key points</summary>
                    <div>
                      {items.map((item) => (
                        <section>
                          {items.length > 1 && <strong>{item.headline}</strong>}
                          <ul>{item.keyPoints.map((point) => <li>{point}</li>)}</ul>
                        </section>
                      ))}
                    </div>
                  </details>
                  <details class="relevance-details">
                    <summary>Why it matters to Proterra</summary>
                    <div>
                      {items.map((item) => (
                        <section>
                          {items.length > 1 && <strong>{item.headline}</strong>}
                          <p>{item.businessRelevance}</p>
                        </section>
                      ))}
                    </div>
                  </details>
                </div>
                <div class="news-row-bottom">
                  <div class="news-tags">{tagsFor(items).map((tag) => <span>{tag}</span>)}</div>
                  {supporting.length > 0 && (
                    <div class="news-supporting-links" aria-label="Supporting sources">
                      <span>Also:</span>
                      {supporting.map((supportingCitation) => (
                        <a href={supportingCitation.url} target="_blank" rel="noreferrer">
                          {citationLabel(supportingCitation.sourceId, supportingCitation.title)}
                        </a>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <aside class="regional-news" id="latin-america" aria-labelledby="regional-news-title">
      <header class="news-section-heading">
        <div>
          <span>Regional watch</span>
          <h3 id="regional-news-title"><a href={`${reportHref}#latin-america`}>Latin America &amp; Puerto Rico</a></h3>
        </div>
      </header>
      {regionalGroups.length > 0 ? regionalGroups.map((items) => {
        const citation = items[0].citations[0];
        const image = imageFor(items);
        return (
          <article class="regional-story" id={`item-${items[0].rank}`}>
            <figure>
              <a href={citation.url} target="_blank" rel="noreferrer" aria-label={`Open source: ${citation.title}`}>
                <img src={image.src} alt={image.alt} width="1280" height="720" loading="lazy" />
              </a>
              <figcaption><a href={image.sourceUrl} target="_blank" rel="noreferrer">Photo: {image.creator}</a></figcaption>
            </figure>
            <span class="regional-publisher">{publisherFor(items)} · {formatDate(citation.publishedAt, { month: "short" })}</span>
            <h4><a href={citation.url} target="_blank" rel="noreferrer">{items[0].headline}</a></h4>
            <p>{items[0].summary}</p>
            <div class="news-row-actions regional-story-actions">
              <details>
                <summary>Key points</summary>
                <div><ul>{items[0].keyPoints.map((point) => <li>{point}</li>)}</ul></div>
              </details>
              <details class="relevance-details">
                <summary>Why it matters to Proterra</summary>
                <div><p>{items[0].businessRelevance}</p></div>
              </details>
            </div>
          </article>
        );
      }) : (
        <p class="regional-empty">No regional source cleared the evidence threshold this week.</p>
      )}
      <p class="regional-policy">Puerto Rico is checked every week. A story appears only when it meets the same standard as the rest of the issue.</p>
    </aside>
  </div>

  <section class="history-callout" aria-labelledby="history-callout-title">
    <div>
      <span>Data dashboard</span>
      <h3 id="history-callout-title">Track the market over time</h3>
      <p>Current readings and historical context for global dairy and meat prices and U.S. cattle supply.</p>
    </div>
    <ArrowLink href="/history" label="Open dashboard" />
  </section>
</section>
