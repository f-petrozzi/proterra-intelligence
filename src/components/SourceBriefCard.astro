---
import { formatDate, sectorLabel, sourceById, type SignalItem } from "../lib/content";

interface Props {
  items: SignalItem[];
  priority?: boolean;
}

const { items, priority = false } = Astro.props;
const item = items[0];
const [primary] = item.citations;
const supportingSources = items
  .flatMap((candidate) => candidate.citations)
  .filter((citation) => citation.url !== primary.url)
  .filter((citation, index, citations) => citations.findIndex((candidate) => candidate.url === citation.url) === index);
const publisher = sourceById.get(primary.sourceId);
const initials = (publisher?.name ?? primary.sourceId)
  .split(/\s+/)
  .filter((word) => word.length > 2)
  .slice(0, 2)
  .map((word) => word[0])
  .join("")
  .toUpperCase();
const typeLabel = item.documentType.replace("-", " ");
const sectorTags = [...new Set(items.flatMap((candidate) => candidate.sectors))];
const regionTags = [...new Set(items.flatMap((candidate) => candidate.regions))];
const isReviewed = items.every((candidate) => candidate.reviewStatus === "reviewed");
---

<article class:list={["source-brief-card", { priority }]} id={`item-${item.rank}`}>
  {items.slice(1).map((candidate) => <span class="source-anchor" id={`item-${candidate.rank}`} aria-hidden="true"></span>)}
  <div class="source-brief-identity">
    <span class="publisher-mark" aria-hidden="true">{initials}</span>
    <div>
      <strong>{publisher?.name ?? primary.sourceId}</strong>
      <span>{formatDate(primary.publishedAt)} · {typeLabel}</span>
    </div>
    <span class:list={["reviewed-label", { pending: !isReviewed }]}>{isReviewed ? "Reviewed" : "Pending review"}</span>
  </div>

  <h3><a href={primary.url} target="_blank" rel="noreferrer">{primary.title}</a></h3>
  <div class="source-topics">
    {items.map((candidate) => (
      <section>
        <h4>{candidate.headline}</h4>
        <p class="source-digest">{candidate.summary}</p>
        <div class="source-key-points">
          <span>Key points</span>
          <ul>
            {candidate.keyPoints.map((point) => <li>{point}</li>)}
          </ul>
        </div>
      </section>
    ))}
  </div>

  <footer class="source-brief-footer">
    <div class="source-brief-tags" aria-label="Coverage tags">
      {sectorTags.map((sector) => <span>{sectorLabel(sector)}</span>)}
      {regionTags.map((region) => <span>{region}</span>)}
    </div>
    <a class="source-primary-link" href={primary.url} target="_blank" rel="noreferrer">
      Open source
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 13 13 3M6 3h7v7" /></svg>
    </a>
  </footer>

  {supportingSources.length > 0 && (
    <details class="supporting-sources">
      <summary>{supportingSources.length} supporting source{supportingSources.length === 1 ? "" : "s"}</summary>
      <ul>
        {supportingSources.map((citation) => (
          <li>
            <a href={citation.url} target="_blank" rel="noreferrer">
              <span>{sourceById.get(citation.sourceId)?.name ?? citation.sourceId}</span>
              <strong>{citation.title}</strong>
            </a>
          </li>
        ))}
      </ul>
    </details>
  )}
</article>
