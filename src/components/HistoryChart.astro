---
import type { HistoryChart as HistoryChartType } from "../lib/history";

interface Props {
  chart: HistoryChartType;
}

const { chart } = Astro.props;
const width = 760;
const height = 300;
const margin = { top: 18, right: 22, bottom: 38, left: 56 };
const innerWidth = width - margin.left - margin.right;
const innerHeight = height - margin.top - margin.bottom;
const allValues = chart.series.flatMap((series) => series.points.map((point) => point.value));
const rawMax = Math.max(...allValues);
const datePoints = chart.series[0].points;
const roughStep = rawMax / 4;
const magnitude = 10 ** Math.floor(Math.log10(Math.max(roughStep, 0.1)));
const normalizedStep = roughStep / magnitude;
const stepMultiplier = [1, 2, 2.5, 4, 5, 10].find((candidate) => candidate >= normalizedStep) ?? 10;
const tickStep = stepMultiplier * magnitude;
const max = Math.ceil(rawMax / tickStep) * tickStep;
const y = (value: number) => margin.top + ((max - value) / max) * innerHeight;
const yTicks = Array.from({ length: 5 }, (_, index) => max - tickStep * index);
const groupWidth = innerWidth / datePoints.length;
const seriesGap = chart.series.length > 1 ? 3 : 0;
const barWidth = Math.min((groupWidth * 0.72 - seriesGap * (chart.series.length - 1)) / chart.series.length, 24);
const groupBarsWidth = barWidth * chart.series.length + seriesGap * (chart.series.length - 1);
const groupCenter = (index: number) => margin.left + groupWidth * (index + 0.5);
const barX = (periodIndex: number, seriesIndex: number) => groupCenter(periodIndex) - groupBarsWidth / 2 + seriesIndex * (barWidth + seriesGap);
const formatValue = (value: number) => value.toFixed(1);
---

<article class="history-chart" aria-labelledby={`${chart.id}-title`}>
  <header class="history-chart-header">
    <div>
      <span>{chart.period} · {chart.cadence}</span>
      <h2 id={`${chart.id}-title`}>{chart.title}</h2>
      <p>{chart.description}</p>
      <small class="history-chart-basis">{chart.basis}</small>
    </div>
    <div class="history-legend" aria-label="Latest values">
      {chart.series.map((series) => {
        const first = series.points[0].value;
        const latest = series.points.at(-1)!.value;
        const change = ((latest - first) / first) * 100;
        return (
          <div>
            <span><i style={`--series-color:${series.color}`}></i>{series.label}</span>
            <div class="history-legend-value"><strong>{formatValue(latest)}</strong><span>{chart.unit}</span></div>
            <small class:list={{ positive: change > 0, negative: change < 0 }}>
              {change > 0 ? "+" : ""}{change.toFixed(1)}% over period
            </small>
          </div>
        );
      })}
    </div>
  </header>

  <div class="history-plot">
    <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-labelledby={`${chart.id}-svg-title ${chart.id}-svg-desc`}>
      <title id={`${chart.id}-svg-title`}>{chart.title}</title>
      <desc id={`${chart.id}-svg-desc`}>{chart.description}. Each group shows one reporting period. Values are also available in the table below.</desc>

      {yTicks.map((tick) => (
        <g>
          <line x1={margin.left} x2={width - margin.right} y1={y(tick)} y2={y(tick)} class="chart-grid-line" />
          <text x={margin.left - 10} y={y(tick) + 4} text-anchor="end" class="chart-axis-label">{formatValue(tick)}</text>
        </g>
      ))}

      {datePoints.map((point, index) => (
        <text
          x={groupCenter(index)}
          y={height - 10}
          text-anchor="middle"
          class:list={{ "chart-axis-label": true, latest: index === datePoints.length - 1 }}
        >
          {point.label}
        </text>
      ))}

      {chart.series.map((series, seriesIndex) => (
        <g style={`--series-color:${series.color}`}>
          {series.points.map((point, periodIndex) => {
            const renderedHeight = Math.max(y(0) - y(point.value), 1);
            return (
              <rect
                x={barX(periodIndex, seriesIndex)}
                y={y(point.value)}
                width={barWidth}
                height={renderedHeight}
                rx="2"
                class:list={{ "history-bar": true, latest: periodIndex === series.points.length - 1 }}
              >
                <title>{series.label}, {point.label}: {formatValue(point.value)} {chart.unit}</title>
              </rect>
            );
          })}
        </g>
      ))}
    </svg>
  </div>

  <footer class="history-chart-footer">
    <p>{chart.note}</p>
    <a href={chart.sourceUrl} target="_blank" rel="noreferrer">{chart.sourceTitle}</a>
  </footer>

  <details class="history-data-table">
    <summary>View data table</summary>
    <div>
      <table>
        <caption>{chart.title}, {chart.unit}</caption>
        <thead>
          <tr><th scope="col">Period</th>{chart.series.map((series) => <th scope="col">{series.label}</th>)}</tr>
        </thead>
        <tbody>
          {datePoints.map((point, index) => (
            <tr><th scope="row">{point.label}</th>{chart.series.map((series) => <td>{formatValue(series.points[index].value)}</td>)}</tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>
</article>
