---
import { formatDate, sourceById, type SignalItem } from "../lib/content";

interface Props {
  item: SignalItem;
}

const { item } = Astro.props;
const sourceCount = item.citations.length;
---

<wa-details class="evidence-disclosure" appearance="plain" icon-placement="end">
  <div slot="summary" class="evidence-summary">
    <span>Sources and next watch</span>
    <span>{sourceCount} {sourceCount === 1 ? "source" : "sources"} · {item.confidence} confidence</span>
  </div>

  <div class="evidence-content">
    <div class="evidence-context">
      {item.uncertainty && (
        <section class="evidence-limit" aria-labelledby={`uncertainty-${item.rank}`}>
          <h4 id={`uncertainty-${item.rank}`}>What remains unclear</h4>
          <p>{item.uncertainty}</p>
        </section>
      )}
      <section class="watch-next" aria-labelledby={`watch-${item.rank}`}>
        <h4 id={`watch-${item.rank}`}>What to watch next</h4>
        <p>{item.watchNext}</p>
      </section>
    </div>

    <section class="source-evidence" aria-labelledby={`sources-${item.rank}`}>
      <h4 id={`sources-${item.rank}`}>Evidence</h4>
      <ol class="citation-list">
        {item.citations.map((citation) => {
          const isPdf = new URL(citation.url).pathname.toLowerCase().endsWith(".pdf");
          return (
            <li>
              <a href={citation.url} target="_blank" rel="noreferrer">
                <span class="citation-copy">
                  <span class="citation-publisher">{sourceById.get(citation.sourceId)?.name}</span>
                  <strong>{citation.title}</strong>
                  <span class="source-note">{citation.sourceNote}</span>
                </span>
                <span class="citation-meta">
                  <time datetime={citation.publishedAt}>{formatDate(citation.publishedAt, { month: "short" })}</time>
                  <span>{isPdf ? "PDF" : "Source"}</span>
                </span>
              </a>
            </li>
          );
        })}
      </ol>
    </section>
  </div>
</wa-details>

<script>
  import "@awesome.me/webawesome/dist/components/details/details.js";
</script>
