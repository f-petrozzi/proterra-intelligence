---
import type { HistoryChart as HistoryChartType } from "../lib/history";

interface Props {
  chart: HistoryChartType;
}

const { chart } = Astro.props;
const latestDate = chart.series.flatMap((series) => series.points.map((point) => point.date)).sort().at(-1)!;
const earliestDate = chart.series.flatMap((series) => series.points.map((point) => point.date)).sort()[0];
const monthSpan = (Number(latestDate.slice(0, 4)) - Number(earliestDate.slice(0, 4))) * 12
  + Number(latestDate.slice(5, 7)) - Number(earliestDate.slice(5, 7)) + 1;
const rangeOptions = (chart.cadence === "Annual" ? [] : [
  { label: "12M", months: 12 },
  { label: "3Y", months: 36 },
  { label: "5Y", months: 60 },
  { label: "10Y", months: 120 }
]).filter((option) => monthSpan >= option.months - 1);
const defaultRange = chart.cadence === "Quarterly" && rangeOptions.some((option) => option.months === 60)
  ? 60
  : rangeOptions[0]?.months ?? "all";
const largestNamedRange = rangeOptions.at(-1)?.months ?? 0;
const showFullRange = rangeOptions.length > 0 && monthSpan > largestNamedRange;
const chartPayload = JSON.stringify(chart).replaceAll("<", "\\u003c");

function formatValue(value: number) {
  if (chart.format === "currency-2") return `$${value.toFixed(2)}`;
  if (chart.format === "integer") return Math.round(value).toLocaleString("en-US");
  return value.toFixed(1);
}

function formatUpdateDate(value: string) {
  return new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC"
  }).format(new Date(`${value}T00:00:00Z`));
}
---

<article
  class="history-chart interactive-history-chart"
  id={chart.id}
  data-default-range={defaultRange}
  aria-labelledby={`${chart.id}-title`}
>
  <header class="history-chart-header">
    <div class="history-chart-copy">
      <div class="history-chart-kicker">
        <span>{chart.region}</span>
        <span>{chart.cadence}</span>
        <span>Data refreshed {chart.updatedAt}</span>
      </div>
      <h2 id={`${chart.id}-title`}>{chart.title}</h2>
      <p class="history-question">{chart.question}</p>
      <p>{chart.description}</p>
    </div>
    <div class="history-legend" aria-label="Latest values">
      {chart.series.map((series) => {
        const latest = series.points.at(-1)!;
        return (
          <div>
            <span><i style={`--series-color:${series.color}`}></i>{series.label}</span>
            <div class="history-legend-value"><strong>{formatValue(latest.value)}</strong><span>{chart.unit}</span></div>
            <small>{latest.label}</small>
          </div>
        );
      })}
    </div>
  </header>

  <div class:list={["history-chart-toolbar", { "single-control": rangeOptions.length === 0 }]} aria-label={`${chart.title} chart controls`}>
    {rangeOptions.length > 0 && (
      <fieldset class="history-range-control">
        <legend>Time range</legend>
        <div>
          {rangeOptions.map((option) => (
            <button type="button" data-range={option.months} aria-pressed={option.months === defaultRange ? "true" : "false"}>{option.label}</button>
          ))}
          {showFullRange && <button type="button" data-range="all" aria-pressed="false">Full</button>}
        </div>
      </fieldset>
    )}
    <fieldset class="history-view-control">
      <legend>View</legend>
      <div>
        <button type="button" data-view="value" aria-pressed="true">Values</button>
        <button type="button" data-view="change" aria-pressed="false">Change</button>
      </div>
    </fieldset>
    <div class="history-chart-type" aria-live="polite"><span>Chart</span><strong data-chart-type>Bars</strong></div>
  </div>

  <div class="history-plot" role="img" aria-label={`${chart.title}. Use the controls to change the period and view.`}></div>
  <div class="dashboard-tooltip history-hover-tooltip" role="tooltip" hidden>
    <span data-tooltip-period></span><strong data-tooltip-value></strong><small data-tooltip-series></small><small data-tooltip-change hidden></small>
  </div>

  <div class="history-insights" aria-live="polite">
    <div><span>Range change</span><strong data-insight="change">Loading</strong></div>
    <div><span>Period high</span><strong data-insight="high">Loading</strong></div>
    <div><span>Latest move</span><strong data-insight="latest">Loading</strong></div>
  </div>

  <div class="history-chart-context">
    <div><span>How to read it</span><p>{chart.basis}</p></div>
    <div>
      <div class="history-context-heading">
        <span>Important context</span>
        <time datetime={chart.updatedAt}>Updated {formatUpdateDate(chart.updatedAt)}</time>
      </div>
      <p>{chart.note}</p>
    </div>
  </div>

  <footer class="history-chart-footer">
    <p>Source data, definitions, and revisions remain with the publisher.</p>
    <a href={chart.sourceUrl} target="_blank" rel="noreferrer">View {chart.sourceTitle}</a>
  </footer>

  <details class="history-data-table">
    <summary>View source values</summary>
    <div>
      <table>
        <caption>{chart.title}, {chart.unit}</caption>
        <thead><tr><th scope="col">Period</th>{chart.series.map((series) => <th scope="col">{series.label}</th>)}</tr></thead>
        <tbody>
          {chart.series[0].points.map((point, index) => (
            <tr><th scope="row">{point.label}</th>{chart.series.map((series) => <td>{formatValue(series.points[index].value)}</td>)}</tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>
  <script type="application/json" class="history-chart-data" is:inline set:html={chartPayload}></script>
</article>

<script>
  import * as Plot from "@observablehq/plot";

  type Point = { date: string; label: string; value: number };
  type Series = { label: string; color: string; points: Point[] };
  type Chart = {
    id: string;
    title: string;
    cadence: string;
    unit: string;
    format: "integer" | "decimal-1" | "currency-2";
    series: Series[];
  };

  const monthNumber = (date: string) => Number(date.slice(0, 4)) * 12 + Number(date.slice(5, 7));

  function displayValue(chart: Chart, value: number, view: string) {
    if (view === "change") return `${value > 0 ? "+" : ""}${value.toFixed(1)}%`;
    if (chart.format === "currency-2") return `$${value.toFixed(2)}`;
    if (chart.format === "integer") return Math.round(value).toLocaleString("en-US");
    return value.toFixed(1);
  }

  function initChart(root: HTMLElement) {
    if (root.dataset.ready) return;
    root.dataset.ready = "true";
    const dataElement = root.querySelector<HTMLScriptElement>(".history-chart-data");
    const plotElement = root.querySelector<HTMLElement>(".history-plot");
    if (!dataElement || !plotElement) return;
    const plotContainer = plotElement;
    const chart = JSON.parse(dataElement.textContent ?? "") as Chart;
    const tooltip = root.querySelector<HTMLElement>(".history-hover-tooltip");
    if (tooltip) document.body.append(tooltip);
    let range = root.dataset.defaultRange ?? "all";
    let view = "value";
    let resizeTimer = 0;

    const rangeButtons = [...root.querySelectorAll<HTMLButtonElement>("[data-range]")];
    const viewButtons = [...root.querySelectorAll<HTMLButtonElement>("[data-view]")];

    function positionTooltip(clientX: number, clientY: number) {
      if (!tooltip) return;
      tooltip.hidden = false;
      const bounds = tooltip.getBoundingClientRect();
      const left = Math.min(clientX + 14, window.innerWidth - bounds.width - 10);
      const top = clientY - bounds.height - 14 > 8 ? clientY - bounds.height - 14 : clientY + 14;
      tooltip.style.left = `${Math.max(8, left)}px`;
      tooltip.style.top = `${Math.max(8, top)}px`;
    }

    function render() {
      const latestMonth = Math.max(...chart.series.flatMap((series) => series.points.map((point) => monthNumber(point.date))));
      const rangeMonths = range === "all" ? Number.POSITIVE_INFINITY : Number(range);
      const visibleSeries = chart.series.map((series) => ({
        ...series,
        points: series.points.filter((point) => latestMonth - monthNumber(point.date) < rangeMonths)
      }));
      const periods = [...new Map(visibleSeries.flatMap((series) => series.points.map((point) => [point.date, point.label])))]
        .sort(([a], [b]) => a.localeCompare(b));
      const periodIndex = new Map(periods.map(([date], index) => [date, index]));
      const seriesCount = chart.series.length;
      const groupWidth = 0.78;
      const barWidth = groupWidth / seriesCount;
      const rows = visibleSeries.flatMap((series, seriesIndex) => {
        const baseline = series.points[0]?.value ?? 0;
        return series.points.map((point) => {
          const index = periodIndex.get(point.date) ?? 0;
          const plottedValue = view === "change" && baseline !== 0 ? ((point.value - baseline) / baseline) * 100 : point.value;
          return {
            series: series.label,
            period: point.label,
            rawValue: point.value,
            plottedValue,
            x: index,
            x1: index - groupWidth / 2 + seriesIndex * barWidth,
            x2: index - groupWidth / 2 + (seriesIndex + 1) * barWidth - 0.025
          };
        });
      });
      const tickEvery = Math.max(1, Math.ceil(periods.length / (plotContainer.clientWidth < 600 ? 5 : 9)));
      const tickValues = periods.map((_, index) => index).filter((index) => index % tickEvery === 0 || index === periods.length - 1);
      const zeroBase = view === "value";
      const useLine = range === "all" ? monthNumber(periods.at(-1)?.[0] ?? "0-01") - monthNumber(periods[0]?.[0] ?? "0-01") >= 24 : Number(range) > 24;
      const chartTypeLabel = root.querySelector<HTMLElement>("[data-chart-type]");
      if (chartTypeLabel) chartTypeLabel.textContent = useLine ? "Trend line" : "Bars";
      const dataMarks = useLine
        ? [
            Plot.lineY(rows, { x: "x", y: "plottedValue", stroke: "series", z: "series", strokeWidth: 2.2 }),
            Plot.dot(rows, { x: "x", y: "plottedValue", fill: "series", stroke: "#fafaf6", strokeWidth: 1.2, r: plotContainer.clientWidth < 600 ? 4.5 : 3.5, className: "history-plot-point" }),
            Plot.dot(rows, { x: "x", y: "plottedValue", fill: "transparent", stroke: "transparent", r: 11, className: "history-plot-hit" })
          ]
        : [
            Plot.rectY(rows, {
              x1: "x1",
              x2: "x2",
              y1: 0,
              y2: "plottedValue",
              fill: "series",
              opacity: 0.88,
              rx: 2,
              className: "history-plot-bar"
            })
          ];
      const plot = Plot.plot({
        width: Math.max(plotContainer.clientWidth, 320),
        height: plotContainer.clientWidth < 600 ? 300 : 360,
        marginTop: 20,
        marginRight: 20,
        marginBottom: 46,
        marginLeft: 64,
        style: { background: "transparent", color: "#5e6963", fontFamily: "Aptos, Segoe UI, sans-serif", fontSize: "11px" },
        color: { domain: chart.series.map((series) => series.label), range: chart.series.map((series) => series.color), legend: false },
        x: {
          domain: [-0.55, Math.max(periods.length - 0.45, 0.55)],
          ticks: tickValues,
          tickFormat: (index: number) => periods[Math.round(index)]?.[1] ?? "",
          tickSize: 0,
          label: null
        },
        y: {
          grid: true,
          label: view === "change" ? "Change from range start (%)" : chart.unit,
          nice: true,
          zero: zeroBase,
          tickFormat: (value: number) => view === "change" ? `${value}%` : displayValue(chart, value, view)
        },
        marks: [
          Plot.ruleY([0], { stroke: "#aeb5b0" }),
          ...dataMarks
        ]
      });
      plot.setAttribute("aria-label", `${chart.title}, ${periods[0]?.[1] ?? ""} through ${periods.at(-1)?.[1] ?? ""}`);
      plotContainer.replaceChildren(plot);
      const targets = useLine
        ? [...plot.querySelectorAll<SVGCircleElement>(".history-plot-hit circle, circle.history-plot-hit")]
        : [...plot.querySelectorAll<SVGRectElement>(".history-plot-bar rect, rect.history-plot-bar")];
      targets.forEach((target, index) => {
        const row = rows[index];
        if (!row || !tooltip) return;
        const show = (event: Event) => {
          if (!(event instanceof PointerEvent)) return;
          document.querySelectorAll<HTMLElement>(".dashboard-tooltip").forEach((candidate) => {
            if (candidate !== tooltip) candidate.hidden = true;
          });
          const periodLabel = tooltip.querySelector<HTMLElement>("[data-tooltip-period]");
          const valueLabel = tooltip.querySelector<HTMLElement>("[data-tooltip-value]");
          const seriesLabel = tooltip.querySelector<HTMLElement>("[data-tooltip-series]");
          const changeLabel = tooltip.querySelector<HTMLElement>("[data-tooltip-change]");
          if (periodLabel) periodLabel.textContent = row.period;
          if (valueLabel) valueLabel.textContent = displayValue(chart, row.rawValue, "value");
          if (seriesLabel) seriesLabel.textContent = `${row.series} · ${chart.unit}`;
          if (changeLabel) {
            changeLabel.hidden = view !== "change";
            changeLabel.textContent = `${displayValue(chart, row.plottedValue, "change")} from range start`;
          }
          tooltip.style.setProperty("--tooltip-color", chart.series.find((series) => series.label === row.series)?.color ?? "#173f32");
          positionTooltip(event.clientX, event.clientY);
        };
        target.addEventListener("pointerenter", show);
        target.addEventListener("pointermove", show);
        target.addEventListener("pointerdown", show);
      });

      const allVisible = visibleSeries.flatMap((series) => series.points.map((point) => ({ ...point, series: series.label })));
      const latestChanges = visibleSeries.map((series) => {
        const latest = series.points.at(-1);
        const previous = series.points.at(-2);
        return latest && previous && previous.value !== 0 ? { label: series.label, value: ((latest.value - previous.value) / previous.value) * 100 } : null;
      }).filter(Boolean) as { label: string; value: number }[];
      const rangeChanges = visibleSeries.map((series) => {
        const first = series.points[0];
        const latest = series.points.at(-1);
        return first && latest && first.value !== 0 ? `${series.label} ${displayValue(chart, ((latest.value - first.value) / first.value) * 100, "change")}` : null;
      }).filter(Boolean);
      const high = allVisible.reduce((best, point) => !best || point.value > best.value ? point : best, allVisible[0]);
      const biggestLatest = latestChanges.reduce((best, item) => !best || Math.abs(item.value) > Math.abs(best.value) ? item : best, latestChanges[0]);
      const rangeInsight = root.querySelector<HTMLElement>('[data-insight="change"]');
      const highInsight = root.querySelector<HTMLElement>('[data-insight="high"]');
      const latestInsight = root.querySelector<HTMLElement>('[data-insight="latest"]');
      if (rangeInsight) rangeInsight.textContent = rangeChanges.join(" · ") || "Not enough history";
      if (highInsight) highInsight.textContent = high ? `${high.series} ${displayValue(chart, high.value, "value")} · ${high.label}` : "Not available";
      if (latestInsight) latestInsight.textContent = biggestLatest ? `${biggestLatest.label} ${displayValue(chart, biggestLatest.value, "change")}` : "Not enough history";
    }

    rangeButtons.forEach((button) => button.addEventListener("click", () => {
      range = button.dataset.range ?? "all";
      rangeButtons.forEach((candidate) => candidate.setAttribute("aria-pressed", String(candidate === button)));
      render();
    }));
    viewButtons.forEach((button) => button.addEventListener("click", () => {
      view = button.dataset.view ?? "value";
      viewButtons.forEach((candidate) => candidate.setAttribute("aria-pressed", String(candidate === button)));
      render();
    }));
    new ResizeObserver(() => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(render, 120);
    }).observe(plotContainer);
    plotContainer.addEventListener("pointerleave", (event) => {
      if (event.pointerType === "mouse" && tooltip) tooltip.hidden = true;
    });
    render();
  }

  document.querySelectorAll<HTMLElement>(".interactive-history-chart").forEach(initChart);
</script>
