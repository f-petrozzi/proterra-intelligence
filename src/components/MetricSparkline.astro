---
interface Point {
  label: string;
  value: number;
}

interface Props {
  points: Point[];
  label: string;
  color: string;
}

const { points, label, color } = Astro.props;
const width = 220;
const height = 68;
const inset = 5;
const values = points.map((point) => point.value);
const min = Math.min(...values);
const max = Math.max(...values);
const range = Math.max(max - min, 0.1);
const x = (index: number) => inset + (index / Math.max(points.length - 1, 1)) * (width - inset * 2);
const y = (value: number) => inset + ((max - value) / range) * (height - inset * 2);
const line = points.map((point, index) => `${x(index)},${y(point.value)}`).join(" ");
const area = `${inset},${height - inset} ${line} ${width - inset},${height - inset}`;
const latest = points.at(-1)!;
---

<svg class="metric-sparkline" viewBox={`0 0 ${width} ${height}`} role="img" aria-label={`${label} trend from ${points[0].label} to ${latest.label}`} style={`--spark-color:${color}`}>
  <polygon points={area} class="metric-sparkline-area" />
  <polyline points={line} class="metric-sparkline-line" />
  <circle cx={x(points.length - 1)} cy={y(latest.value)} r="3.5" class="metric-sparkline-point" />
</svg>
