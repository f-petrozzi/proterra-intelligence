<section class="digest-signup" aria-labelledby="digest-signup-title">
  <div class="digest-copy">
    <span class="digest-eyebrow">Stay informed</span>
    <h2 id="digest-signup-title">The weekly digest, in your inbox.</h2>
    <p>Reviewed news on dairy, meat, and bovine genetics. One weekly email, with the sources that matter.</p>
  </div>
  <div class="digest-options">
    <div class="digest-actions">
      <a class="digest-primary" href={"/subscriptions"}>Subscribe to the digest <span aria-hidden="true">→</span></a>
      <a class="digest-secondary" href={"/subscriptions?intent=invite"}>Invite someone</a>
    </div>
