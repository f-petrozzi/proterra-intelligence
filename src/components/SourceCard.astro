---
import ArrowLink from "./ArrowLink.astro";
import { sectorLabel, type Source } from "../lib/content";

interface Props {
  source: Source;
}

const { source } = Astro.props;
const hostname = new URL(source.url).hostname.replace(/^www\./, "");
---

<article class="source-card">
  <div class="source-identity">
    <span class="source-domain">{hostname}</span>
    <h2>{source.name}</h2>
    <p>{source.notes}</p>
  </div>

  <dl>
    <div>
      <dt>Coverage</dt>
      <dd>{source.sectors.map(sectorLabel).join(", ")}</dd>
    </div>
    <div>
      <dt>Geography</dt>
      <dd>{source.regions.join(", ")}</dd>
    </div>
    <div>
      <dt>Cadence</dt>
      <dd>{source.cadence}</dd>
    </div>
    <div>
      <dt>Status</dt>
      <dd class={`source-status status-${source.status}`}>{source.status}</dd>
    </div>
  </dl>

  <ArrowLink href={source.url} label="Visit source" external />
</article>
