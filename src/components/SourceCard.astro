---
import ArrowLink from "./ArrowLink.astro";
import { sectorLabel, type Source } from "../lib/content";

interface Props {
  source: Source;
}

const { source } = Astro.props;
const hostname = new URL(source.url).hostname.replace(/^www\./, "");
const origin = (import.meta.env.PUBLIC_REVIEW_ORIGIN || "https://proterra-intelligence-review.petrozzi.workers.dev").replace(/\/$/, "");
const reviewUrl = `${origin}/sources/${source.id}`;
---

<article
  class="source-card"
  id={`source-${source.id}`}
  data-source-card
  data-status={source.status}
  data-sectors={source.sectors.join(" ")}
  data-search={`${source.name} ${hostname} ${source.notes} ${source.regions.join(" ")}`.toLowerCase()}
>
  <div class="source-identity">
    <div class="source-card-topline">
      <span class="source-domain">{hostname}</span>
      <span class={`source-status status-${source.status}`}>{source.status}</span>
    </div>
    <h2>{source.name}</h2>
    <p>{source.notes}</p>
  </div>

  <dl>
    <div>
      <dt>Coverage</dt>
      <dd>{source.sectors.map(sectorLabel).join(", ")}</dd>
    </div>
    <div>
      <dt>Geography</dt>
      <dd>{source.regions.join(", ")}</dd>
    </div>
    <div>
      <dt>Cadence</dt>
      <dd>{source.cadence}</dd>
    </div>
  </dl>

  <footer class="source-card-actions">
    <ArrowLink href={source.url} label="Visit source" external />
    <a href={reviewUrl}>Review entry</a>
  </footer>
</article>
