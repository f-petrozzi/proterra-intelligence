---
import type { SignalItem } from "../lib/content";
import { sectorLabel } from "../lib/content";
import SignalBadge from "./SignalBadge.astro";

interface Props {
  item: SignalItem;
}

const { item } = Astro.props;
const isLead = item.rank <= 3;
---

<article class:list={["signal-card", { "lead-analysis": isLead }]}>
  <div class="signal-card-topline">
    <span class="rank">{String(item.rank).padStart(2, "0")}</span>
    <SignalBadge signal={item.signal} />
  </div>
  <div class="tag-list" aria-label="Categories">
    {item.sectors.map((sector) => <span>{sectorLabel(sector)}</span>)}
    {item.regions.map((region) => <span>{region}</span>)}
  </div>
  <h3>{item.headline}</h3>
  <p class="story-summary">{item.summary}</p>

  <section class="story-key-points" aria-labelledby={`key-points-${item.rank}`}>
    <h4 id={`key-points-${item.rank}`}>Key points</h4>
    <ul>
      {item.keyPoints.map((point) => <li>{point}</li>)}
    </ul>
  </section>

  <div class:list={["story-analysis", { "with-proterra": item.proterraRelevance }]}>
    <section>
      <h4>Industry impact</h4>
      <p>{item.whyItMatters}</p>
    </section>
    {item.proterraRelevance && (
      <section class="proterra-relevance">
        <h4>Relevance to Proterra</h4>
        <p>{item.proterraRelevance}</p>
      </section>
    )}
  </div>
</article>
