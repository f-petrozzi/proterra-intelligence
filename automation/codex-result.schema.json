{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "commentResponses"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["draft-ready", "coverage-gap"]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "commentResponses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["commentId", "response"],
        "properties": {
          "commentId": { "type": "string", "format": "uuid" },
          "response": { "type": "string", "minLength": 1, "maxLength": 2000 }
        }
      }
    }
  }
}

