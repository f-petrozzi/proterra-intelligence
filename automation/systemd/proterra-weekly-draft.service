[Unit]
Description=Prepare the next Proterra Intelligence weekly draft

[Service]
Type=oneshot
WorkingDirectory=%h/homelab/projects/proterra-signal
# Pin the installed Node version; systemd does not load interactive shell/nvm configuration.
Environment=PATH=%h/.nvm/versions/node/v24.19.0/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/bash scripts/review/run-weekly-draft.sh --scheduled
UMask=0077
TimeoutStartSec=3h
KillMode=control-group
StandardOutput=journal
StandardError=journal
SyslogIdentifier=proterra-weekly-draft

# Intentionally no Install section: start via the timer or manually for rehearsal.
