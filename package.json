{
  "name": "proterra-intelligence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "report:approve": "node --import tsx scripts/reports/approve-report.ts",
    "data:refresh-dashboard": "node --import tsx scripts/data/refresh-dashboard.ts --write",
    "email:preview": "node --import tsx scripts/email/render-weekly-email.ts",
    "email:check": "node --import tsx scripts/email/render-weekly-email.ts --check",
    "email:send": "node --import tsx scripts/email/send-weekly-email.ts",
    "email:automation": "node --import tsx scripts/email/send-automation-email.ts",
    "research:collect": "node --import tsx scripts/collection/collect.ts",
    "research:audit": "node --import tsx scripts/collection/render-audit.ts",
    "research:test": "node --import tsx --test tests/collection/*.test.ts",
    "review:check": "tsc --noEmit -p review-worker/tsconfig.json",
    "review:config-check": "node --import tsx scripts/review/check-deploy-config.ts",
    "review:test": "node --import tsx --test tests/review/*.test.ts",
    "weekly:setup": "bash scripts/setup/weekly-automation.sh",
    "weekly:draft": "node --import tsx scripts/review/weekly-draft.ts",
    "weekly:guard-diff": "node --import tsx scripts/review/assert-weekly-diff.ts",
    "verify": "npm run check && npm run review:check && npm run email:check && npm run research:test && npm run review:test && npm run build"
  },
  "engines": {
    "node": ">=24.19"
  },
  "dependencies": {
    "@awesome.me/webawesome": "^3.11.0",
    "@observablehq/plot": "^0.6.17",
    "cheerio": "^1.2.0",
    "csv-parse": "^7.0.2",
    "fast-xml-parser": "^5.11.0",
    "jose": "^6.2.9",
    "nodemailer": "^9.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-email": "^6.9.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@cloudflare/workers-types": "^5.20260817.1",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "astro": "7.2.2",
    "miniflare": "5.20260811.1-alpha",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "wrangler": "^4.123.0"
  },
  "overrides": {
    "sharp": "0.35.3"
  }
}
